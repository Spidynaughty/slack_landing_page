# Admin login for /admin (one account)
ADMIN_EMAIL=admin@ktteams.example
ADMIN_PASSWORD=change-me-to-a-long-password
# Signs the admin session cookie and the per-page share pictures. Use 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-at-least-32-random-characters

# SEO (optional). Each adds its tag to every page once set.
# Google Search Console: the content of the "HTML tag" verification method
# GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: the content of the msvalidate.01 meta tag
# BING_SITE_VERIFICATION=
# Your App Store app ID (the number in the store URL), for Safari's "Open in app" banner on iPhone
# IOS_APP_ID=

# Database. Defaults to a local SQLite file at .data/ktteams.db.
# For serverless hosting (e.g. Vercel) point this at Turso: libsql://<db>-<org>.turso.io
# DATABASE_URL=file:.data/ktteams.db
# DATABASE_AUTH_TOKEN=
